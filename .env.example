# SASHA — Environment Variables
# DeepSeek API (primary — 5x cache savings vs OpenRouter via prefix caching)
# Cache hit:  $0.028/M input tokens  |  Cache miss: $0.14/M input tokens
VITE_DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# OpenRouter (fallback only — when DeepSeek API is unavailable)
# VITE_OPENROUTER_KEY=sk-or-...
